{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!src/lib/database.types.ts", "!**/*.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/mocks", "@/mocks/**", "**/mocks", "**/mocks.ts"],
                "message": "Telas e lógica usam a API da área (src/office/api, src/technician/api) e os tipos de @/lib/views; dados de exemplo só nas implementações de exemplo e na vitrine /dev."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "src/mocks/**",
        "src/office/mocks.ts",
        "src/office/api/index.ts",
        "src/technician/mocks.ts",
        "src/technician/api/index.ts",
        "src/technician/api/mock.ts",
        "src/technician/api/mock-camera.tsx",
        "src/app/dev/**"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
